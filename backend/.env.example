# ─── NirmanSetu Backend Environment Variables ───
# Copy this file to .env and fill in your values
# ALL services below are FREE tier

# MongoDB Atlas FREE tier (512MB) - https://cloud.mongodb.com
# Create free cluster → Get connection string → paste here
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/nirmansetu?retryWrites=true&w=majority

# JWT Secret - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_secret_key_here_minimum_64_chars

# JWT expiry
JWT_EXPIRE=7d

# Port
PORT=5000

# Frontend URL (for CORS) - in dev: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Node environment: development | production
NODE_ENV=development

# File upload folder (local for dev, use Cloudinary free tier in prod)
UPLOAD_PATH=./uploads

# Optional: Cloudinary FREE tier for image hosting (10GB free)
# https://cloudinary.com - Sign up free
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Email via Gmail (free SMTP) - for OTP notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
